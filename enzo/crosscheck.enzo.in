#
# Driven isothermal MHD turbulence, matched to Stalpes, Collins & Huffenberger
# (2024, arXiv:2404.02874) and to our own solver (src/mhd.c), for the
# Enzo <-> mhd crosscheck.  Generated by python/enzo_setup.py -- edit that,
# not the generated files.
#
# Paper: Enzo, Dedner cleaning, piecewise-linear reconstruction, HLLD,
# gamma-1 = 1e-3, stochastic OU forcing on k/k_min in [1,2] with
# compressive:solenoidal amplitude 2:3 (zeta = 1/2), correlation time t_dyn,
# driven 10 t_dyn, second half analysed.
#
ProblemType                = 59
TopGridRank                = 3
TopGridDimensions          = __N__ __N__ __N__
SelfGravity                = 0
TopGridGravityBoundary     = 0
LeftFaceBoundaryCondition  = 3 3 3
RightFaceBoundaryCondition = 3 3 3

# t_dyn = L0/M_S with L0 = L/2 (the paper's definition, and our solver's)
StopTime                   = __STOP__
dtDataDump                 = __DTDUMP__
DataDumpName               = data
ParallelRootGridIO         = 1

StaticHierarchy            = 1
MaximumRefinementLevel     = 0

HydroMethod                = 4        # MUSCL + Dedner MHD
RiemannSolver              = 6        # HLLD
ReconstructionMethod       = 0        # PLM
CourantSafetyNumber        = 0.4      # same as src/mhd.c
Gamma                      = 1.001    # gamma - 1 = 1e-3, as in the paper
Mu                         = 1.0
Theta_Limiter              = 1.5
EOSType                    = 0
DualEnergyFormalism        = 1

UseDrivingField            = 1
DrivenFlowProfile          = 2            # parabolic
DrivenFlowAlpha            = 2 2 2        # integral length L/2 = L0
DrivenFlowBandWidth        = 1.0 1.0 1.0
DrivenFlowAutoCorrl        = 1.0 1.0 1.0  # OU correlation time = L0 / v = t_dyn
DrivenFlowWeight           = 0.5          # solenoidal weight zeta = 1/2 (paper)
DrivenFlowSeed             = __SEED__
# Enzo's forcing has a fixed amplitude, not a fixed energy injection rate, so
# the achieved M_S differs from this input; python/enzo_setup.py divides the
# target by a measured calibration factor.
DrivenFlowMach             = __MACHIN__ __MACHIN__ __MACHIN__
DrivenFlowDensity          = 1.0
DrivenFlowPressure         = 1.0
# Gaussian units: Enzo divides by sqrt(4 pi).  = sqrt(4 pi) * M_S / M_A
DrivenFlowMagField         = __BIN__

UseSGSModel                = 0
